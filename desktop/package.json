{
  "name": "mesari-desktop",
  "productName": "Mesari",
  "version": "1.2.1",
  "private": true,
  "description": "Mesari para Windows",
  "author": {
    "name": "Mesari"
  },
  "main": "out/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "rebuild": "electron-rebuild -f -o @serialport/bindings-cpp",
    "start": "npm run build && electron ."
  },
  "dependencies": {
    "electron-updater": "6.8.10",
    "serialport": "13.0.0"
  },
  "devDependencies": {
    "@electron/rebuild": "4.2.1",
    "@types/node": "24.10.1",
    "electron": "44.7.0",
    "electron-builder": "26.17.0",
    "eslint": "9.39.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.56.1"
  },
  "allowScripts": {
    "@serialport/bindings-cpp": false,
    "electron-winstaller": false
  }
}
